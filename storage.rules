rules_version = '2';
// NGL Club Hub file storage (staging bucket, London).
// music/{competition}/{folder}/{file}.mp3: a club writes only to its own folder (folder = its uid), MP3 only, up to 15MB.
//   NGL owners and the team ticked for Floor music / the music player read and write everything (intros, announcements).
// resources/{file}: the Judging Pathway library; signed-in users read, the Judging team writes.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true &&
        request.auth.token.email in ['admin@nationalgymnasticsleague.co.uk', 'bookingoffice@saadigymnastics.co.uk'];
    }
    // Team ticks from NGL Admin > Team (Firestore adminUsers/{email})
    function team(apps) {
      return signedIn() && request.auth.token.email_verified == true &&
        firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.token.email.lower())).data.sections.hasAny(apps);
    }
    function mp3() {
      return request.resource.size < 15 * 1024 * 1024 && request.resource.contentType == 'audio/mpeg';
    }
    match /music/{comp}/{folder}/{file} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == folder) || team(['music', 'musicplayer']);
      allow create, update: if file.matches('[A-Za-z0-9_-]+[.]mp3') && mp3()
                            && ((signedIn() && request.auth.uid == folder) || isAdmin() || team(['music', 'musicplayer']));
      allow delete: if isAdmin() || team(['music', 'musicplayer']);
    }
    // Group purchasing logos: groupbuy/{round}/{order id}/front-logo.* and back-logo.*. A club uploads them straight after placing
    // its order (Shop → Group buying), only to that order's own logo paths while it is still 'placed', as an image or PDF under 10MB,
    // and can read its own. The Group purchasing team reads them all.
    function gbOrder(order) { return firestore.get(/databases/(default)/documents/ngl_groupbuy_orders/$(order)).data; }
    function gbMine(order) { return signedIn() && gbOrder(order).clubId == request.auth.uid; }
    match /groupbuy/{round}/{order}/{file} {
      allow read: if isAdmin() || team(['groupbuy', 'finance']) || gbMine(order);
      allow create, update: if gbMine(order) && gbOrder(order).status == 'placed'
                            && ('groupbuy/' + round + '/' + order + '/' + file) in [gbOrder(order).logoPath, gbOrder(order).back.logoPath]
                            && request.resource.size < 10 * 1024 * 1024
                            && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if isAdmin();
    }
    match /resources/{file} {
      allow read: if signedIn();
      allow write: if isAdmin() || team(['judging']);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}

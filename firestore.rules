rules_version = '2';
// NGL Club Hub (one app): security rules. Staging project ngl-club-hub-staging.
// A club can only see and change its own data. Licence status, payment status
// and prices are only changed by NGL (owners, or team members ticked for that app) or the card-payments script.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    // Owners: the two NGL accounts, plus anyone an owner marks as owner in the team list
    function isAdmin() {
      return verified() && (request.auth.token.email in ['admin@nationalgymnasticsleague.co.uk', 'bookingoffice@saadigymnastics.co.uk']
        || (staff() && me().owner == true));
    }
    // NGL team (NGL Admin > Team): adminUsers/{lower-case email} = {name, owner, sections: [app ids]}
    function teamDoc() { return /databases/$(database)/documents/adminUsers/$(request.auth.token.email.lower()); }
    function staff() { return verified() && exists(teamDoc()); }
    function me() { return get(teamDoc()).data; }
    function canAny(apps) { return isAdmin() || (staff() && me().sections.hasAny(apps)); }
    function clubsTeam() { return canAny(['clubs', 'schools-lic', 'rec-lic', 'ps-lic']); }
    function ordersTeam() { return canAny(['orders', 'schools-lic', 'rec-lic', 'ps-lic', 'finance']); }
    function compsTeam() { return canAny(['competitions']); }
    function musicTeam() { return canAny(['music']); }
    function salesTeam() { return canAny(['sales', 'finance']); }

    function own(clubId) { return signedIn() && request.auth.uid == clubId; }
    // The signed-in user's own email, once they've confirmed it by clicking the link we email them
    function emailIs(e) { return verified() && e is string && e != '' && request.auth.token.email.lower() == e; }
    function unchanged(fields) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields); }

    // The NGL team list: owners manage it; each person can read their own entry
    match /adminUsers/{email} {
      allow read: if isAdmin() || (verified() && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    // Club account: one document per club, id = the club's login uid
    match /clubs/{clubId} {
      allow read: if own(clubId) || clubsTeam() || canAny(['music', 'rotation', 'competitions', 'planning']);
      allow create: if own(clubId) && !request.resource.data.keys().hasAny(['licences', 'isAdmin']);
      allow update: if clubsTeam() || (own(clubId) && unchanged(['licences', 'isAdmin']));
      // Rotation Planner clubs: the team can import a club's rotation data, and nothing else
      allow update: if canAny(['rotation']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rotaJson', 'rotaUpdatedAt']);
      // Group purchasing: find a club's app account by the email on an order placed on the old page
      allow read: if canAny(['groupbuy']);
      allow delete: if isAdmin();
    }

    // Orders: a club places them unpaid; owners change anything; the team can only mark paid orders as posted
    match /orders/{orderId} {
      allow read: if ordersTeam() || (signedIn() && resource.data.clubId == request.auth.uid);
      // A club's own order: never a group-buying one, and never an ORD-GB… id (those are NGL's group-buying invoices)
      allow create: if signedIn() && request.resource.data.clubId == request.auth.uid
                    && request.resource.data.status == 'awaiting-payment'
                    && request.resource.data.get('kind', '') != 'groupbuy' && !orderId.matches('ORD-GB.*');
      allow update: if isAdmin() || (ordersTeam() && resource.data.status == 'paid' && request.resource.data.status == 'sent'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sentAt']));
      allow delete: if isAdmin();
      // Group purchasing: when a round closes, NGL turns each club's invoice into an order the club pays by card
      // (orders/ORD-GB{round}-{NN}, kind 'groupbuy'); the card-payments script marks it paid. The team can mark one paid by hand
      // (an exception), undo that, and mark a paid one sent to print; nothing else.
      allow read: if gbTeam() && (resource == null || resource.data.kind == 'groupbuy');
      allow create: if gbTeam() && orderId.matches('ORD-GB[0-9]{6}-[0-9]{2,3}') && request.resource.data.kind == 'groupbuy'
                    && request.resource.data.status == 'awaiting-payment' && request.resource.data.clubId is string && request.resource.data.get('createdBy', '') == 'ngl-admin'
                    && exists(/databases/$(database)/documents/clubs/$(request.resource.data.clubId));
      allow update: if gbTeam() && resource.data.kind == 'groupbuy' && unchanged(['clubId', 'kind', 'lines', 'total', 'invoiceNo', 'createdBy']) && (
                       (resource.data.status == 'awaiting-payment' && request.resource.data.status == 'paid' && request.resource.data.paidBy == 'manual'
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy']))
                    || (resource.data.status == 'paid' && resource.data.get('paidBy', '') == 'manual' && request.resource.data.status == 'awaiting-payment'
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy']))
                    || (resource.data.status == 'paid' && request.resource.data.status == 'sent'
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sentAt'])));
    }
    function gbTeam() { return canAny(['groupbuy', 'finance']); }

    // Competition reservations and floor music records
    match /reservations/{id} {
      allow read: if compsTeam() || salesTeam() || canAny(['planning', 'staffing']) || (signedIn() && resource.data.clubId == request.auth.uid);
      // A club books places as 'reserved', or brings in places booked with its confirmed email before it joined (pendingPlaces, same id).
      allow create: if compsTeam() || (signedIn() && request.resource.data.clubId == request.auth.uid
                    && (request.resource.data.status in ['reserved', 'waiting'] || claimsPending(id)));
      // A club can change its places or cancel while still 'reserved'; only NGL moves places to the waiting list or bought.
      allow update: if compsTeam() || (signedIn() && resource.data.clubId == request.auth.uid && resource.data.status == 'reserved'
                    && unchanged(['clubId', 'compId', 'ref']) && request.resource.data.status in ['reserved', 'cancelled']);
      allow delete: if isAdmin();
    }
    function claimsPending(id) {
      let p = get(/databases/$(database)/documents/pendingPlaces/$(id)).data;
      return emailIs(p.email) && request.resource.data.status == p.status && request.resource.data.places == p.places && request.resource.data.compId == p.compId;
    }
    // Places booked before the club had an account. The club sees and claims them once its email is confirmed; NGL attaches the rest by hand.
    match /pendingPlaces/{id} {
      allow read, delete: if compsTeam() || emailIs(resource.data.email);
      allow create, update: if isAdmin();
      // (Floor music reads club names and emails here to match entries)
      allow read: if canAny(['music', 'finance', 'planning']);
    }
    // Floor music: NGL adds each club's gymnasts per competition (musicEntries/{compId}_{clubId});
    // the club uploads one record per gymnast (musicUploads/{compId}_{gymnastId}).
    match /musicEntries/{id} {
      allow read: if musicTeam() || (signedIn() && resource.data.clubId == request.auth.uid);
      allow write: if musicTeam();
    }
    match /musicUploads/{id} {
      allow read: if musicTeam() || canAny(['musicplayer']) || (signedIn() && resource.data.clubId == request.auth.uid);
      allow create, update: if musicTeam() || signedIn() && request.resource.data.clubId == request.auth.uid
                            && (resource == null || resource.data.clubId == request.auth.uid)
                            && id == request.resource.data.compId + '_' + request.resource.data.gymnastId
                            && exists(/databases/$(database)/documents/musicEntries/$(request.resource.data.compId + '_' + request.auth.uid));
      allow delete: if isAdmin();
    }

    // NGL Admin apps
    // Ticket sales: the JustGo sales summary the "Sync NGL sales" bookmark saves (events, map, syncedAt)
    match /justgoSales/{id} { allow read: if salesTeam() || canAny(['competitions', 'planning']); allow write: if canAny(['finance', 'sales']); }
    // Competition planning: one plan per competition, plus _template and _summary
    match /compPlans/{id} { allow read, write: if canAny(['planning', 'staffing']); }
    // Staffing: who's working each competition, judge requests
    match /staffing/{id} { allow read, write: if canAny(['staffing']); }
    // Judging Pathway lists Staffing reads (same names as the live judging app): sign-ups (Staffing assigns them), bookings, judge profiles
    match /ngl_judge_signups/{id} { allow read, update: if canAny(['staffing', 'judging']); allow create, delete: if canAny(['judging']); }
    match /ngl_judging_assignments/{id} { allow read: if canAny(['staffing', 'judging']); allow write: if canAny(['judging']); }
    match /ngl_judges/{id} { allow read: if canAny(['staffing', 'judging']); allow write: if canAny(['judging']); }
    // Floor music and the competition music player: running order, absences, intros, announcements (musicEvents);
    // the competition from Elevien (musicComps, written by the import tool)
    match /musicEvents/{id} { allow read, write: if canAny(['music', 'musicplayer']); }
    match /musicComps/{id} { allow read: if canAny(['music', 'musicplayer']); allow write: if isAdmin(); }
    // Training League: the public league table reads it without signing in (first name, initial, club, results); BG numbers stay private
    match /ngl_power_league/{id} { allow read: if true; allow write: if canAny(['powerleague']); }
    match /ngl_power_league_private/{id} { allow read: if canAny(['powerleague', 'gl-hub', 'results']); allow write: if canAny(['powerleague']); }
    // NGL P&L: assumptions (settings) and typed actual costs / income targets (actuals)
    match /finance/{id} { allow read, write: if canAny(['finance']) || (id == 'projection' && canAny(['projection'])); }
    // Group purchasing: club orders each quarter (admin invoices, marks paid, sends to the printer); round totals for the public board.
    // A club places its own order from Shop → Group buying: status 'placed', its own clubId, a sensible quantity, the logo paths
    // under groupbuy/{round}/{this order}/, and in the same batch the round's totals go up by exactly this order (gbTotals).
    match /ngl_groupbuy_orders/{id} {
      allow read, update: if gbTeam();
      allow read: if signedIn() && resource.data.clubId == request.auth.uid;
      allow create: if gbNewOrder(id);
      allow delete: if isAdmin();
    }
    function gbNewOrder(id) {
      let d = request.resource.data;
      let dir = 'groupbuy/' + d.round + '/' + id + '/';
      return signedIn() && d.clubId == request.auth.uid && d.status == 'placed'
        && d.round is string && d.round.matches('20[0-9]{2}-(02|05|08|11)') && d.product in ['JC001', 'LV874']
        && d.qty is int && d.qty >= 1 && d.qty <= 2000 && d.sizes is map && d.sizes.size() <= 14
        && d.setupFee in [0, 25] && d.deliveryFee == 20
        && d.logoPath is string && d.logoPath.matches(dir + 'front-logo[.](png|jpg|jpeg|svg|pdf)')
        && (d.back.logoPath == '' || d.back.logoPath.matches(dir + 'back-logo[.](png|jpg|jpeg|svg|pdf)'))
        && !d.keys().hasAny(['invoiceNo', 'invoicedAt', 'invoiceTotal', 'payOrderId', 'paidAt', 'paidBy', 'sentToPrinterAt'])
        && getAfter(/databases/$(database)/documents/ngl_groupbuy_rounds/$(d.round + '_' + d.product)).data.lastOrder == id;
    }
    // Live totals {shirts, orders, updatedAt, lastOrder}: anyone can read (the board). A club can only add its own new order:
    // lastOrder = the order it is creating in the same batch, shirts up by that order's qty, orders up by one.
    match /ngl_groupbuy_rounds/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['shirts', 'orders', 'updatedAt', 'lastOrder']) && gbTotals(id, 0, 0);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shirts', 'orders', 'updatedAt', 'lastOrder'])
                    && gbTotals(id, resource.data.get('shirts', 0), resource.data.get('orders', 0));
    }
    function gbTotals(id, shirts, orders) {
      let d = request.resource.data;
      let o = /databases/$(database)/documents/ngl_groupbuy_orders/$(d.lastOrder);
      return signedIn() && d.lastOrder is string && d.shirts is int && d.orders is int
        && !exists(o) && getAfter(o).data.clubId == request.auth.uid && getAfter(o).data.round + '_' + getAfter(o).data.product == id
        && d.shirts == shirts + getAfter(o).data.qty && d.orders == orders + 1;
    }
    // Parents (not signed in): look up ONE family code at a time (never list them), the club's live timetable, Graduations
    match /familyCodes/{code} { allow get: if true; allow list: if isAdmin(); allow write: if isAdmin() || clubsTeam();
      // a club keeps its own Pre-School term plan up to date (nothing else on the code)
      allow update: if signedIn() && resource.data.clubId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'updatedAt']); }
    match /rotaLive/{clubId} { allow read: if true; allow write: if own(clubId) || isAdmin(); }
    // Rotation Planner: sponsor logos on every club's planner and live screen (anyone can see them; NGL adds and removes them),
    // and clubs' ideas (a club sends its own as 'new'; the NGL team reads them and marks them read)
    match /rotaSponsors/{id} { allow read: if true; allow write: if canAny(['rotation']); }
    match /rotaFeedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new';
      allow read, update, delete: if canAny(['rotation']);
    }
    // Graduations parents see: a club keeps its own in step (id = clubUid_eventId); NGL can change any
    match /familyEvents/{id} { allow read: if true;
      allow create, update: if isAdmin() || clubsTeam() || (signedIn() && request.resource.data.clubId == request.auth.uid && id.matches(request.auth.uid + '_.*'));
      allow delete: if isAdmin() || clubsTeam() || (signedIn() && resource.data.clubId == request.auth.uid); }
    // Judging admin: notifications to judges, and the resources library
    match /ngl_judge_notifications/{id} { allow read, write: if canAny(['judging']); }
    match /ngl_resources/{id} { allow read, write: if canAny(['judging']); }

    // Judging Pathway, judge side (js/views/judge.js). A judge logs in with the app's own login and has ngl_judges/{uid}, no clubs doc.
    // These add to the NGL team rules above (rules that match the same document are OR'd); nothing above changes.
    function isJudge() { return signedIn() && exists(/databases/$(database)/documents/ngl_judges/$(request.auth.uid)); }
    // Fields a judge may set on their own profile: what they type when they register, edit My Profile, their photo and quiz bests.
    // Anything else NGL keeps on a profile (now or later: approval, notes, a fixed tier) can only be changed by the Judging team.
    function judgeFields() { return ['name', 'club', 'phone', 'qualifications', 'qualification', 'photoUrl', 'quizBestWag', 'quizBestMag']; }
    match /ngl_judges/{uid} {
      allow get: if own(uid);
      // a club sees the judges linked to it (invited by the club, or matched by club name at switch-over)
      allow read: if signedIn() && resource.data.clubId == request.auth.uid;
      allow create: if own(uid)
                    && request.resource.data.keys().hasOnly(['name', 'club', 'clubId', 'email', 'phone', 'qualifications', 'qualification', 'photoUrl', 'priorShadowed', 'priorSecondJudged', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name != ''
                    && request.resource.data.email is string && request.resource.data.email.lower() == request.auth.token.email.lower()
                    && request.resource.data.priorShadowed is int && request.resource.data.priorShadowed >= 0 && request.resource.data.priorShadowed <= 500
                    && request.resource.data.priorSecondJudged is int && request.resource.data.priorSecondJudged >= 0 && request.resource.data.priorSecondJudged <= 500;
      allow update: if own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(judgeFields());
    }
    // Applications: a judge applies only as themselves and only as 'pending' (NGL confirms or declines); they can withdraw
    // or cancel their own (the live page deletes it). They read their own, and every confirmed booking (the Judging Calendar).
    match /ngl_judging_assignments/{id} {
      allow read: if signedIn() && resource.data.judgeUid == request.auth.uid;
      allow read: if isJudge() && resource.data.status == 'confirmed';
      allow create: if isJudge() && request.resource.data.judgeUid == request.auth.uid && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['judgeUid', 'judgeName', 'compId', 'compName', 'compDate', 'compVenue', 'discipline', 'piece', 'role', 'status', 'assignedAt', 'judgingMode', 'quotedFee'])
                    && request.resource.data.role in ['shadow', 'second_judge', 'judge'] && request.resource.data.discipline in ['WAG', 'MAG']
                    && request.resource.data.compId is string && request.resource.data.get('quotedFee', 50) in [50, 75];
      allow delete: if signedIn() && resource.data.judgeUid == request.auth.uid;
    }
    // Notifications NGL sends a judge (accepted / declined): read their own only
    match /ngl_judge_notifications/{id} { allow read: if signedIn() && resource.data.judgeUid == request.auth.uid; }
    // The resources library on the Resources tab (files are in Storage resources/, which signed-in users already read)
    match /ngl_resources/{id} { allow read: if signedIn(); }

    // Shared content every signed-in club can read: competitions calendar, products, rules
    match /competitions/{id} { allow read: if signedIn(); allow write: if compsTeam();
      // Booking emails: the MyBG link and the send log, by the Competitions or Competition planning team
      allow update: if canAny(['competitions', 'planning']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['justgoUrl', 'mailLog', 'booking']); }
    match /products/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }
    // Places each club bought on JustGo (from the JustGo sales sync): the club reads its own; NGL Admin rebuilds them
    match /compBought/{id} { allow read: if compsTeam() || salesTeam() || (signedIn() && resource.data.clubId == request.auth.uid);
      allow write: if compsTeam() || salesTeam(); }
    // Places reserved per competition, so clubs see places left / fully reserved: one row per club, places only (no names).
    // A club keeps its own row ({compId}__{uid}); NGL Admin rebuilds them all from the reservations.
    match /compPlaces/{id} { allow read: if signedIn(); allow write: if compsTeam();
      allow create, update: if signedIn() && id == request.resource.data.compId + '__' + request.auth.uid && request.resource.data.clubId == request.auth.uid
                            && request.resource.data.keys().hasOnly(['compId', 'clubId', 'places']) && request.resource.data.places is int && request.resource.data.places >= 0 && request.resource.data.places <= 500;
      allow delete: if signedIn() && resource.data.clubId == request.auth.uid; }
    // Judging invites: a club invites its staff to the Judging Pathway (its own only); the Judging team sees them all
    match /judgeInvites/{id} { allow read: if canAny(['judging']) || (signedIn() && resource.data.clubId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.clubId == request.auth.uid && request.resource.data.keys().hasOnly(['clubId', 'clubName', 'name', 'email', 'at'])
                    && request.resource.data.email is string && request.resource.data.name is string;
      allow delete: if canAny(['judging']) || (signedIn() && resource.data.clubId == request.auth.uid); }
    match /resources/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }

    // The full Recreational programme: clubs with a live Recreational licence, and NGL owners
    function recLicensed() { return signedIn() && get(/databases/$(database)/documents/clubs/$(request.auth.uid)).data.licences.recreational.status == 'live'; }
    match /recContent/{id} { allow read: if isAdmin() || recLicensed(); allow write: if isAdmin(); }
    // The content itself is readable by anyone who knows its key (the key is the secret, as on the live site): parents get it from their code
    match /recShared/{key}/docs/{id} { allow read: if true; allow write: if isAdmin(); }
    // Data move report (rehearsal and switch-over): NGL owners only
    match /migration/{id} { allow read: if isAdmin(); allow write: if false; }

    // Everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
